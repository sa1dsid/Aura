<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name="com.aura.probe.PushTokenProbe"
            android:authorities="${applicationId}.push-probe"
            android:exported="false" />

        <receiver
            android:name="com.aura.probe.PushProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name="com.aura.probe.CrashProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
    </application>

</manifest>
