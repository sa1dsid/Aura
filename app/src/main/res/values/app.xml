<?xml version="1.0" encoding="utf-8"?>
<!-- Собственные ключи приложения. Поставляемый strings.xml заменяется целиком,
     поэтому всё, чего нет в поставке, живёт здесь. Список отдаётся команде
     локализации на включение в следующую поставку. -->
<resources>
    <string name="app_name">Aura</string>

    <string name="home_logo">I Ø Aura</string>
    <string name="home_connecting">CONNECTING TO MESH</string>
    <string name="cd_menu">Menu</string>
    <string name="unit_ion">ION</string>
    <string name="timer_paused_vpn">PAUSED · VPN ON</string>

    <string name="network_mobile_2g">Mobile 2G</string>
    <string name="network_mobile_3g">Mobile 3G</string>
    <string name="network_mobile_4g">Mobile 4G</string>
    <string name="network_mobile_5g">Mobile 5G</string>
    <string name="network_wifi">Wi-Fi</string>
    <string name="network_none">No network</string>

    <!-- Network: единицы и заглушки. Числа и единицы не переводятся никогда. -->
    <string name="unit_ms">ms</string>
    <string name="unit_percent">%</string>
    <string name="unit_mbps">Mbps</string>
    <string name="net_value_empty">--</string>
    <string name="net_ping_value">%1$dms</string>
    <string name="net_vpn_off">OFF</string>
    <string name="net_protocol_ipv4">IPv4</string>
    <string name="net_protocol_ipv6">IPv6</string>

    <!-- Строка под заголовком, когда последний замер был не сегодня: «JUL 09 · 21:47». -->
    <string name="net_last_tested_earlier">%1$s · %2$s</string>

    <!-- Ping History: подписи оси Y. -->
    <string name="net_axis_top">70ms</string>
    <string name="net_axis_bottom">0ms</string>

    <!-- network_log.json: запись занимает две строки, комментарии группируют по датам.
         Ключи и разделители — часть JSON-подобного лога, не переводятся. -->
    <string name="net_log_day">// %1$s (%2$d presses)</string>
    <string name="net_log_line_head">%1$s:ip:%2$s,isp:%3$s,ping:%4$s</string>
    <string name="net_log_line_tail">location:%1$s,vpn:%2$s</string>
    <string name="net_log_number">%1$02d</string>
    <string name="net_log_vpn_on">on</string>
    <string name="net_log_vpn_off">off</string>

    <!-- Диагностика: подписи шкалы и центрального блока. -->
    <string name="diag_scale_min">0</string>
    <string name="diag_scale_mark">100</string>
    <string name="diag_scale_max">1000</string>
    <string name="diag_ping">Ping</string>
    <string name="diag_arrow_down">↓</string>
    <string name="diag_arrow_up">↑</string>

    <!-- ДЛИННАЯ: пустой журнал, состояние в макете не рисовалось. -->
    <string name="net_history_empty">No measurements yet · run a test to start the log</string>
    <!-- ДЛИННАЯ: текст системного шэра результата диагностики. -->
    <string name="diag_share_text">Download %1$s Mbps · Upload %2$s Mbps · Ping %3$s ms · measured with IO Aura</string>

    <string name="net_handle">@%1$s</string>

    <string name="cd_share">Share result</string>

    <string name="brand_i">I</string>
    <string name="brand_aura">Aura</string>
    <string name="auth_email_placeholder">you@example.com</string>
    <string name="invite_code_placeholder">SYREX482</string>

    <!-- Бургер-меню. В поставке заказчика есть только пункты меню; шапка аккаунта,
         способ входа и строка версии в списке ключей не пришли. -->
    <string name="account_handle">@%1$s</string>
    <string name="menu_account_meta">%1$s · %2$s</string>
    <string name="menu_provider_google">Google</string>
    <string name="menu_provider_email">Email</string>
    <string name="menu_version">IO Aura · v%1$s</string>

    <!-- Кликабельные куски auth_terms_line. Отдельные ключи нужны потому, что
         в переводе форма слова отличается от пункта меню: menu_privacy — это
         «Конфиденциальность», а в строке согласия стоит «Политику
         конфиденциальности», и поиском по menu_privacy ссылка не находится. -->
    <string name="auth_terms_link">Terms of Service</string>
    <string name="auth_privacy_link">Privacy Policy</string>

    <!-- Terminal, Transactions и Promo Codes. В поставке заказчика от 09.08 этих ключей
         нет (ТЗ Transactions от 12.08 обещает их следующей поставкой), поэтому блок
         временный: когда строки придут, заменить на их ID и убрать отсюда.
         Логотип на Терминале — КОРОТКАЯ форма «I Ø» без слова Aura, так задумано
         дизайнером, поэтому ключ отдельный от home_logo. -->
    <string name="terminal_logo">I Ø</string>
    <string name="terminal_title">Terminal</string>
    <string name="terminal_card_transactions">TRANSACTIONS</string>
    <string name="terminal_card_transactions_hint">unread</string>
    <string name="terminal_card_promo">PROMO CODES</string>
    <string name="terminal_card_promo_hint">tap to check</string>
    <string name="terminal_card_counter">+%1$d</string>

    <string name="tx_title">Transactions</string>
    <!-- ДЛИННАЯ: подзаголовок экрана, в макете переносится на две строки. -->
    <string name="tx_subtitle">Every ION and Spark event — coupons live separately in Promo Codes</string>
    <string name="tx_history">HISTORY</string>
    <string name="tx_filter_all">ALL</string>
    <string name="tx_filter_ion">ION</string>
    <string name="tx_filter_spark">SPARK</string>
    <string name="tx_filter_data_share">DATA SHARE</string>
    <string name="tx_filter_referral">REFERRAL</string>
    <string name="tx_filter_exchange">EXCHANGE</string>
    <string name="tx_empty_title">No events yet</string>
    <string name="tx_empty_text">Press the button on Home to start earning</string>

    <!-- transactions_log.json: событие занимает две строки, комментарии группируют по
         датам. Ключи и разделители — часть JSON-подобного лога, не переводятся.
         Типы, источники и суммы приходят с сервера как есть и тоже не переводятся. -->
    <string name="tx_log_title">transactions_log.json · %1$d events</string>
    <string name="tx_log_day">// %1$s (%2$d events)</string>
    <string name="tx_log_line_head">%1$s:type:%2$s,%3$s:%4$s,</string>
    <string name="tx_log_line_tail">amount:%1$s</string>
    <string name="tx_log_more">// scroll for more ↓</string>

    <string name="promo_title">Promo Codes</string>
    <!-- ДЛИННАЯ: подзаголовок экрана, в макете переносится на две строки. -->
    <string name="promo_subtitle">Every code you\'ve earned — VPN and Spark, tap a ticket to copy</string>
    <string name="promo_section_spark">SPARK CODES</string>
    <string name="promo_section_vpn">VPN CODES</string>
    <string name="promo_badge_spark">SPARK</string>
    <string name="promo_badge_vpn">VPN</string>
    <string name="promo_more_spark">scroll for %1$d more Spark codes ↓</string>
    <string name="promo_more_vpn">scroll for %1$d more VPN codes ↓</string>
    <string name="promo_empty_title">No codes yet</string>
    <!-- ДЛИННАЯ: пустое состояние, в макете переносится на две строки. -->
    <string name="promo_empty_text">Earn Spark and reach targets to get your first one</string>
    <string name="promo_ticket_date">%1$s, %2$s</string>
    <string name="promo_copied">Code copied</string>

    <!-- Ник в шапке вложенного экрана. Дубликат net_handle по смыслу — свести в один
         ключ, когда придёт поставка строк. -->
    <string name="handle_format">@%1$s</string>

    <string name="cd_back">Back</string>
    <string name="cd_copy_code">Copy code</string>
</resources>
